# Secret used to sign magic-link tokens (required)
APP_SECRET=change-me-to-a-long-random-string

# SMTP (optional — without these the server creates an Ethereal test account
# and prints the preview URL instead of sending real mail)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASS=pass

# Public base URL used inside magic links
BASE_URL=http://localhost:3000

PORT=3000
