# Install: apt install fail2ban  OR  yum install fail2ban
# Copy to /etc/fail2ban/jail.local, then: systemctl enable --now fail2ban

[DEFAULT]
bantime = 3600
findtime = 600
maxretry = 3
banaction = iptables-multiport

[sshd]
enabled = true
port = ssh
logpath = %(sshd_log)s
backend = systemd

[nginx-http-auth]
enabled = true
port = http,https
logpath = /var/log/nginx/error.log

# Bans IPs that get banned repeatedly — keeps persistent offenders out
[recidive]
enabled = true
logpath = /var/log/fail2ban.log
bantime = 86400
findtime = 86400
maxretry = 5
