# syntax=docker/dockerfile:1.7
# BuildKit cache mounts: package-manager caches persist across builds
# without being baked into any layer.

FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
# Mount npm cache as a volume (persists across builds)
RUN --mount=type=cache,target=/root/.npm npm ci

COPY . .
RUN --mount=type=cache,target=/root/.npm npm run build 2>/dev/null || true

# --- Python equivalent ---
# FROM python:3.12-slim AS builder
# COPY requirements.txt .
# RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt

# --- Go equivalent ---
# RUN --mount=type=cache,target=/go/pkg/mod \
#     --mount=type=cache,target=/root/.cache/go-build \
#     CGO_ENABLED=0 go build -ldflags="-s -w" -o server .

FROM node:20-alpine AS production

WORKDIR /app
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev
COPY --from=builder /app/index.js ./index.js

USER node
EXPOSE 3000
CMD ["node", "index.js"]
