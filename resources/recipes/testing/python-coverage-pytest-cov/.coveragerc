[run]
source = sample_app
branch = True
omit =
    sample_app/__init__.py
    sample_app/migrations/*
    */tests/*

[report]
show_missing = True
skip_covered = False
fail_under = 80
exclude_lines =
    pragma: no cover
    def __repr__
    if TYPE_CHECKING:
    raise NotImplementedError
    if __name__ == .__main__.:

[html]
directory = htmlcov
