# Copy to ~/.dbt/profiles.yml (or keep next to dbt_project.yml and
# run with --profiles-dir .). Credentials stay out of version control.
my_project:
  target: dev
  outputs:
    dev:
      type: postgres
      host: localhost
      port: 5432
      user: analytics
      pass: "{{ env_var('DB_PASSWORD') }}"
      dbname: warehouse
      schema: dbt_dev
      threads: 4
    prod:
      type: postgres
      host: warehouse.internal
      port: 5432
      user: dbt_prod
      pass: "{{ env_var('DB_PASSWORD_PROD') }}"
      dbname: warehouse
      schema: analytics
      threads: 8
