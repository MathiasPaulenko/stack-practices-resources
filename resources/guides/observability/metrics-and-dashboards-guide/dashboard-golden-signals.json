{
  "dashboard": {
    "title": "Orders Service - Golden Signals",
    "uid": "orders-golden-signals",
    "tags": ["orders", "golden-signals"],
    "templating": {
      "list": [
        {
          "name": "service",
          "type": "query",
          "query": "label_values(http_requests_total, service)",
          "current": {"text": "orders", "value": "orders"}
        },
        {
          "name": "environment",
          "type": "custom",
          "query": "production,staging",
          "current": {"text": "production", "value": "production"}
        }
      ]
    },
    "panels": [
      {
        "title": "Request Rate",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8},
        "targets": [{
          "expr": "sum(rate(http_requests_total{service=\"$service\",environment=\"$environment\"}[5m])) by (status)",
          "legendFormat": "{{status}}"
        }]
      },
      {
        "title": "Error Ratio",
        "type": "stat",
        "gridPos": {"x": 8, "y": 0, "w": 8, "h": 8},
        "targets": [{
          "expr": "sum(rate(http_requests_total{service=\"$service\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"$service\"}[5m]))"
        }],
        "thresholds": [
          {"value": 0.001, "color": "green"},
          {"value": 0.01, "color": "yellow"},
          {"value": 0.05, "color": "red"}
        ]
      },
      {
        "title": "Latency p95",
        "type": "timeseries",
        "gridPos": {"x": 16, "y": 0, "w": 8, "h": 8},
        "targets": [{
          "expr": "histogram_quantile(0.95, sum(rate(request_duration_seconds_bucket{service=\"$service\"}[5m])) by (le))"
        }]
      },
      {
        "title": "Saturation",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 8, "w": 24, "h": 6},
        "targets": [
          {"expr": "active_connections{service=\"$service\"}", "legendFormat": "active connections"},
          {"expr": "process_resident_memory_bytes{service=\"$service\"}", "legendFormat": "memory"}
        ]
      },
      {
        "title": "Orders per minute",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 14, "w": 12, "h": 6},
        "targets": [{
          "expr": "sum(rate(orders_total{result=\"success\"}[1m])) * 60"
        }]
      },
      {
        "title": "Payment success rate",
        "type": "stat",
        "gridPos": {"x": 12, "y": 14, "w": 12, "h": 6},
        "targets": [{
          "expr": "sum(rate(payment_attempts_total{result=\"success\"}[15m])) / sum(rate(payment_attempts_total[15m]))"
        }]
      }
    ]
  }
}
