{
  "name": "snapshot-testing-pattern",
  "private": true,
  "version": "1.0.0",
  "description": "Runnable Jest snapshot testing examples for the Snapshot Testing pattern",
  "scripts": {
    "test": "jest",
    "test:ci": "jest --ci",
    "test:update": "jest --updateSnapshot"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/*.test.jsx"]
  }
}
