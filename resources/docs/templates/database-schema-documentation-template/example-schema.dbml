// Example e-commerce schema in DBML
// Paste into https://dbdiagram.io/d to render the ER diagram
// Companion to stackpractices.com/docs/database-schema-documentation-template/

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [unique, not null, note: 'Unique, lowercase on insert via trigger']
  password_hash varchar(255) [not null, note: 'Argon2id hash, never log or expose']
  display_name varchar(100)
  status smallint [not null, default: 1, note: '0=deleted, 1=active, 2=suspended, 3=pending_verification']
  metadata jsonb [default: `'{}'`, note: 'Feature flags, preferences — no PII']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'Soft delete marker']

  indexes {
    status [name: 'users_status_idx', note: 'Filter active users in admin panel (014)']
    created_at [name: 'users_created_at_idx', note: 'Pagination by creation date (022)']
  }
}

Table orders {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id, note: 'CASCADE DELETE']
  total_cents integer [not null, default: 0, note: 'Total in cents, never float']
  currency char(3) [not null, default: 'USD', note: 'ISO 4217']
  status smallint [not null, default: 0, note: '0=pending, 1=paid, 2=shipped, 3=delivered, 4=cancelled, 5=refunded']
  placed_at timestamptz [not null, default: `now()`]
  shipped_at timestamptz

  indexes {
    user_id [name: 'orders_user_id_idx', note: 'List orders by user']
    (status, placed_at) [name: 'orders_status_placed_at_idx', note: 'Admin dashboard (014)']
  }
}

Table order_items {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, ref: > orders.id, note: 'CASCADE DELETE']
  product_id uuid [not null]
  quantity integer [not null, default: 1]
  unit_price_cents integer [not null, note: 'Price at time of purchase']
}

Table user_preferences {
  user_id uuid [pk, ref: - users.id, note: 'One-to-one, optional']
  locale varchar(10) [default: 'en']
  timezone varchar(50) [default: 'UTC']
  notifications jsonb [default: `'{}'`]
}
